# JobPulse Environment Variables
# Copy this file to .env and update the values

# Database
DATABASE_URL=sqlite:///./jobpulse.db

# Security (generate a strong secret for production)
# Generate with: openssl rand -hex 32
SECRET_KEY=
# Google Cloud Console > Credentials > OAuth 2.0 Client ID (Web application)
GOOGLE_CLIENT_ID=

# CV document storage (use S3-compatible storage for ephemeral cloud hosts)
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# CORS (comma-separated list of allowed origins)
CORS_ORIGINS=["http://localhost","http://localhost:80","https://jobpulse-frontend-7axe.onrender.com"]

# Environment
ENVIRONMENT=production
