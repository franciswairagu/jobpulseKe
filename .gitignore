# ---- Python bytecode / caches ----
__pycache__/
*.py[cod]
*$py.class
*.pyc

# ---- Virtual environments ----
venv/
env/
.venv/
.env

# ---- Editor / IDE ----
.vscode/
.idea/
*.swp
.DS_Store

# ---- Jupyter ----
.ipynb_checkpoints/

# ---- Generated data & analytics outputs ----
# These are regenerated by running the pipeline; keep them out of Git.
data/exports/
data/processed/*.parquet
data/processed/*.csv
!data/processed/master_full.csv
data/processed/.last_*
data/nlp/*.parquet
!data/nlp/jobs_nlp_enriched_20260923_020116.parquet
data/rag/*.parquet
data/rag/*.npy
data/rag/*.npz
data/raw/master_africa_tech_jobs.csv

# ---- Scraper output (regenerated each run) ----
output/
scripts/output/

# ---- Runtime logs ----
logs/

# ---- Temp / misc ----
files.zip
tree.txt
*.zip

# NOTE: this does NOT ignore reports/*.md — the written reports are
# deliverables and are committed intentionally.

# ---- Build / dist output ----
ui/jobpulse-unified-app2.0/dist/

# ---- Node dependencies ----
node_modules/
**/node_modules/
