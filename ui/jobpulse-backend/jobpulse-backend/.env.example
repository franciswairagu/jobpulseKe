# --- Database / cache ---
DATABASE_URL=postgresql+psycopg2://jobpulse:jobpulse@db:5432/jobpulse
REDIS_URL=redis://redis:6379/0

# --- Auth ---
SECRET_KEY=
# Set this in both the Google Cloud OAuth client and the backend deployment.
GOOGLE_CLIENT_ID=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# --- Storage ---
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
LOCAL_STORAGE_DIR=./data/uploads
MAX_CV_UPLOAD_MB=10

# --- ML model paths ---
# Optional. If this file doesn't exist, CV analysis still runs (skills,
# years experience, education, certifications) - only tech_category
# classification is skipped, and the API reports classifier_available=false.
CV_CATEGORY_MODEL_PATH=./data/models/tech_category_classifier.joblib
MODEL_DEVICE=cpu

# --- Job data ingestion ---
JOB_DATASET_PATH=./data/processed/jobpulse_cleaned.parquet
# Optional machine-to-machine token for the scheduled ingestion workflow.
# Set the same secret in GitHub Actions as JOBPULSE_INGEST_TOKEN.
AUTOMATED_INGEST_TOKEN=

# --- Misc ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,https://jobpulse-ke-seven.vercel.app
