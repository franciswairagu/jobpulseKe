# --- Database / cache ---
DATABASE_URL=postgresql+psycopg2://jobpulse:jobpulse@db:5432/jobpulse
REDIS_URL=redis://redis:6379/0

# --- Auth ---
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# --- Storage ---
STORAGE_PROVIDER=local
STORAGE_BUCKET=
LOCAL_STORAGE_DIR=./data/uploads
MAX_CV_UPLOAD_MB=10

# --- ML model paths ---
# Optional. If this file doesn't exist, CV analysis still runs (skills,
# years experience, education, certifications) - only tech_category
# classification is skipped, and the API reports classifier_available=false.
CV_CATEGORY_MODEL_PATH=./data/models/tech_category_classifier.joblib
MODEL_DEVICE=cpu

# --- Job data ingestion ---
JOB_DATASET_PATH=./data/processed/jobpulse_cleaned.parquet

# --- Misc ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
