# JobPulse full-refresh schedule: every six hours in Nairobi time.
# Copy this file, set these two values for the target machine, then install it
# with: crontab /path/to/jobpulse-scrapers.cron
CRON_TZ=Africa/Nairobi
JOBPULSE_ROOT=/absolute/path/to/jobpulse
JOBPULSE_PYTHON=/absolute/path/to/venv/bin/python

# Option A: Scrape + TechMap merge + pipeline (stages 1-4). Recommended.
0 */6 * * * cd "$JOBPULSE_ROOT" && "$JOBPULSE_PYTHON" scripts/run_pipeline.py --max-pages 5 --nlp-batch-size 1000

# Option B: Skip scrapers, just merge existing data + run pipeline (useful if
# you only add new TechMap files and don't need to re-scrape).
# 0 */6 * * * cd "$JOBPULSE_ROOT" && "$JOBPULSE_PYTHON" scripts/run_pipeline.py --no-scrape --nlp-batch-size 1000
